# Copier ce fichier vers .env et adapter les valeurs

# Environnement d'exécution : local | dev | staging | prod
APP_ENV=local

# Niveau de log : debug | info | warning | error
LOG_LEVEL=info

# API
APP_HOST=0.0.0.0
APP_PORT=8000

# Base de données (SQLite). Lue par app/database.py (DATABASE_URL) si définie ; sinon
# valeur par défaut sqlite:///<racine du projet>/jury_central.db.
DATABASE_URL=sqlite:///./jury_central.db

# Signature des cookies de session admin (à remplacer par une valeur aléatoire forte en production)
SECRET_KEY=changeme

# Identifiants de l'unique compte admin (pas de gestion multi-utilisateurs pour l'instant)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Génération et correction d'exercices par IA (ticket #10). Laisser vide pour désactiver
# la fonctionnalité (message clair côté UI, aucune erreur serveur). Jamais commité, jamais
# transmis au navigateur, jamais journalisé — voir docs/ai_exercise_engine.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20
