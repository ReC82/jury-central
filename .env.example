# Copier ce fichier vers .env et adapter les valeurs

# Environnement d'exécution : local | dev | staging | prod
APP_ENV=local

# Niveau de log : debug | info | warning | error
LOG_LEVEL=info

# API
APP_HOST=0.0.0.0
APP_PORT=8000

# Base de données (SQLite en local ; non encore lue par l'application, valeur codée en dur dans app/database.py)
DATABASE_URL=sqlite:///./jury_central.db

# Secrets (à préciser lors de l'implémentation)
SECRET_KEY=changeme
